rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'; }
    match /products/{productId} {
      allow read: if resource.data.active == true || admin();
      allow create, update, delete: if admin();
    }
    match /admins/{uid} { allow read: if request.auth.uid == uid || admin(); allow write: if false; }
    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.total >= 0;
      allow read, update: if admin();
      allow delete: if false;
    }
  }
}
