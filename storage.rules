rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if admin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if admin();
    }
    match /custom-orders/{orderId}/{fileName} {
      allow write: if signedIn()
        && firestore.get(/databases/(default)/documents/orders/$(orderId)).data.customerUid == request.auth.uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow read, delete: if admin();
    }
  }
}
